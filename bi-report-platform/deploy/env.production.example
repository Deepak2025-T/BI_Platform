# /opt/ReportAI/backend/.env on the server. Copy, fill in, keep out of git.
#
# systemd reads this file as well as the app, so keep it to plain KEY=value lines with no inline
# comments and no quotes - systemd would take the quotes as part of the value.

DATABASE_URL=postgresql+psycopg://reportai:PUT-THE-DB-PASSWORD-HERE@127.0.0.1:5432/reportai

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=PUT-A-LONG-RANDOM-STRING-HERE
JWT_EXPIRE_MINUTES=480

# The address people open the app at. Served from the same host as the API, so this only matters
# if you ever put the frontend somewhere else - but a wrong value here is a silent sign-in failure.
CORS_ORIGINS=https://reports.example.com

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up separately from the database. Without it, saved connection passwords and AI API
# keys cannot be decrypted, and there is no way to recover them.
CONNECTIONS_KEY=PUT-THE-FERNET-KEY-HERE

SCHEDULER_ENABLED=true
AI_TIMEOUT_SECONDS=300
AI_DASHBOARD_MAX_SECONDS=1500
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m
