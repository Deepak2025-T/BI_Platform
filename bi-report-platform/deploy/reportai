#!/usr/bin/env bash
#
# reportai - start, stop and look at ReportsAI on this server.
#
# Installed by server-setup.sh as /usr/local/bin/reportai, so it is just:
#
#   reportai start | stop | restart | status | logs | health | url
#
# It wraps systemd rather than replacing it: the service is still reportai-api, still starts on
# boot, and still restarts itself if it dies. What this adds is the part that is easy to forget -
# start waits until the API actually answers instead of only reporting that systemd accepted the
# command, and tells you the address to open.
set -euo pipefail

SERVICE=reportai-api
APP_DIR=/opt/ReportAI
NGINX_SITE=/etc/nginx/sites-enabled/reportai
UNIT=/etc/systemd/system/$SERVICE.service

# Root runs systemctl directly; anybody else goes through the sudoers rule server-setup installed.
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

port() { grep -oP -- '--port \K[0-9]+' "$UNIT" 2>/dev/null || echo 8000; }
bind() { grep -oP -- '--host \K[0-9.]+' "$UNIT" 2>/dev/null || echo 127.0.0.1; }

# The address to open, worked out from what is actually configured rather than guessed.
show_url() {
    local p host ip web
    p=$(port)
    if [ -e "$NGINX_SITE" ]; then
        # The port nginx serves this app on. It is deliberately not 80: another application owns
        # 80 and 443 on this server, so this one has a port to itself.
        web=$(grep -oP '^\s*listen\s+\K[0-9]+' "$NGINX_SITE" | head -1 || true)
        host=$(grep -oP 'server_name \K[^;]+' "$NGINX_SITE" | head -1 | awk '{print $1}' || true)
        # server_name _ matches anything, so it is not an address anyone can type - use the IP.
        if [ -z "$host" ] || [ "$host" = "_" ]; then
            host=$(ip -4 addr show scope global 2>/dev/null | grep -oP 'inet \K[\d.]+' | head -1 || true)
        fi
        [ -n "$web" ] && echo "  http://${host:-this-server}:$web/     (through nginx - open this)"
    fi
    if [ "$(bind)" = "0.0.0.0" ]; then
        ip=$(ip -4 addr show scope global 2>/dev/null | grep -oP 'inet \K[\d.]+' | head -1 || true)
        echo "  http://${ip:-this-server}:$p/     (straight to the API)"
    else
        echo "  the API itself is bound to $(bind):$p, so only this machine reaches it directly"
    fi
}

# Waits for the API to answer rather than guessing at a sleep: systemd returns as soon as the
# process starts, which is before the database pool is open and anything can be served.
wait_healthy() {
    local p; p=$(port)
    for i in $(seq 1 30); do
        if curl -fsS --max-time 5 "http://127.0.0.1:$p/api/health" >/dev/null 2>&1; then
            echo "ReportsAI is up (healthy after ${i}s). Open:"
            show_url
            return 0
        fi
        sleep 1
    done
    echo "The service started but did not answer on 127.0.0.1:$p within 30s." >&2
    echo "What it says for itself:" >&2
    as_root journalctl -u "$SERVICE" -n 30 --no-pager >&2
    return 1
}

case "${1:-}" in

start)
    as_root systemctl start "$SERVICE"
    wait_healthy
    ;;

stop)
    as_root systemctl stop "$SERVICE"
    echo "ReportsAI is stopped. It will start again on boot - 'reportai disable' prevents that."
    ;;

restart)
    # Anybody mid-build loses that build; saved reports and their data are untouched.
    as_root systemctl restart "$SERVICE"
    wait_healthy
    ;;

status)
    as_root systemctl status "$SERVICE" --no-pager || true
    echo
    echo "Address:"
    show_url
    ;;

logs)
    # `logs` follows; `logs 200` prints the last 200 lines and stops.
    if [ -n "${2:-}" ]; then
        as_root journalctl -u "$SERVICE" -n "$2" --no-pager
    else
        echo "Following the log. Ctrl+C to stop."
        as_root journalctl -u "$SERVICE" -f
    fi
    ;;

health)
    curl -fsS --max-time 10 "http://127.0.0.1:$(port)/api/health" && echo
    ;;

url)
    show_url
    ;;

enable|disable)
    as_root systemctl "$1" "$SERVICE"
    ;;

*)
    cat >&2 <<USAGE
reportai - ReportsAI on this server

  reportai start          start it, and wait until it answers
  reportai stop           stop it
  reportai restart        restart it - needed after changing $APP_DIR/backend/.env
  reportai status         is it running, and at which address
  reportai logs           follow the log (Ctrl+C to stop)
  reportai logs 200       the last 200 log lines
  reportai health         ask the API whether it is well
  reportai url            the address to open
  reportai enable         start on boot (the default)
  reportai disable        do not start on boot

To release new code: bash $APP_DIR/deploy/deploy.sh release
USAGE
    exit 2
    ;;
esac
