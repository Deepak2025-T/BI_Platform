# Copy this file to .env and change the values.
DATABASE_URL=postgresql+psycopg://bi:bi_dev_password@localhost:5432/bi_db

# Use a long random string. In PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# The React dev server address (comma-separate several)
CORS_ORIGINS=http://localhost:5173

# Encrypts saved database connection passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe and separate from database backups: without it,
# saved connection passwords can't be read.
CONNECTIONS_KEY=

# Local AI models (Ollama). Room for one call, prompt and answer together: Ollama's own default
# is 4096 regardless of the model, which a connection of a dozen tables fills with schema alone,
# and the answer is then cut off. Lower it if the machine runs short of memory.
OLLAMA_NUM_CTX=16384
# How long a model stays loaded between calls.
OLLAMA_KEEP_ALIVE=30m
# How long to wait for an answer, in seconds.
AI_TIMEOUT_SECONDS=300
