# Copy this file to .env and change the values.
DATABASE_URL=postgresql+psycopg://bi:bi_dev_password@localhost:5432/bi_db

# Use a long random string. In PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# The React dev server address (comma-separate several)
CORS_ORIGINS=http://localhost:5173

# Encrypts saved database connection passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe and separate from database backups: without it,
# saved connection passwords can't be read.
CONNECTIONS_KEY=
